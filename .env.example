# ---- Site ----
# Canonical production origin (no trailing slash)
SITE_URL=https://gameshowroomrockaway.com
# Indexing guard: robots noindex + Disallow everywhere unless explicitly "true".
# Set to true ONLY on the production Netlify context at launch.
ALLOW_INDEXING=false

# ---- Analytics / Ads (public IDs, not secrets — still kept out of code) ----
PUBLIC_GTM_ID=
PUBLIC_GA4_ID=
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_GOOGLE_ADS_LEAD_LABEL=
PUBLIC_META_PIXEL_ID=
PUBLIC_MS_UET_ID=
# Consent Mode v2 default for analytics_storage: "denied" (EU-safe) or "granted" (US default)
PUBLIC_CONSENT_ANALYTICS_DEFAULT=granted
# Default for ad_storage / ad_user_data / ad_personalization.
# "granted" = US opt-out model (banner hidden; footer "Cookie settings" lets visitors decline).
# "denied"  = opt-in model (banner shown on first visit). Confirm with counsel — not legal advice.
PUBLIC_CONSENT_ADS_DEFAULT=granted

# ---- Booking ----
PUBLIC_FAREHARBOR_SHORTNAME=mysteryroom-rockaway

# ---- Business profiles (fill when verified) ----
PUBLIC_GOOGLE_BUSINESS_PROFILE_URL=
